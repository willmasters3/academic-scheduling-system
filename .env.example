# Demo environment template
# Copy to .env for local development. Do not commit real secrets.

NODE_ENV=development
PORT=3000

# Session and cookies
SESSION_SECRET=replace-with-a-local-random-secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
HELMET_CSP_ENABLED=false

# SQL Server connection for a fictitious demo database
DB_USER=demo_user
DB_PASSWORD=demo_password
DB_HOST=localhost
DB_PORT=1433
DB_NAME=agendamentos_demo
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Optional AI providers. Leave keys empty unless you configure your own.
AI_PROVIDER=disabled
OPENAI_MODEL=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

LOG_LEVEL=info
